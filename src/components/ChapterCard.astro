---
import { route } from '../lib/routes';

import type { Chapter } from '../lib/site';

import { chapterStatus } from '../lib/chapterNotes';

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;

const url = route(`chapters/${chapter.slug}`);

const status = chapterStatus(chapter.slug);
---

<a class="chapter-card" href={url}>
  <div class="chapter-top">
    <span class="chapter-num">Ch {chapter.number}</span>

    <span class={`badge ${status}`}>{status === 'available' ? 'Available' : 'Coming soon'}</span>
  </div>

  <span class="chapter-title">{chapter.title}</span>

  <span class="chapter-topics">{chapter.topics.join(' · ')}</span>

  <style>
    .chapter-card {
      display: flex;

      flex-direction: column;

      gap: var(--space-sm);

      padding: var(--space-lg);

      background: var(--color-surface);

      border: 1px solid var(--color-border);

      border-radius: var(--radius-md);

      color: var(--color-text);
    }

    .chapter-card:hover {
      border-color: var(--color-accent);

      color: var(--color-text);
    }

    .chapter-top {
      display: flex;

      align-items: center;

      justify-content: space-between;
    }

    .chapter-num {
      font-family: var(--font-mono);

      font-size: var(--font-size-micro);

      letter-spacing: var(--tracking-caps);

      text-transform: uppercase;

      color: var(--color-accent);
    }

    .badge {
      padding: 2px 10px;

      border-radius: var(--radius-pill);

      font-size: var(--font-size-micro);

      background: var(--color-accent-soft);

      color: var(--color-text-muted);
    }

    .chapter-title {
      font-weight: var(--font-weight-semibold);
    }

    .chapter-topics {
      color: var(--color-text-muted);

      font-size: var(--font-size-label);
    }
  </style>
</a>
