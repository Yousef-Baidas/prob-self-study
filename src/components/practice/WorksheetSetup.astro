---
import { chapters } from '../../lib/site';
import { route } from '../../lib/routes';
import { COUNT_MAX, COUNT_MIN, SOURCES, WORKSHEET_DEFAULTS } from '../../run/defaults';
const action = route('worksheet');
// The same constants the parser falls back to, so a bare worksheet link behaves
// exactly like submitting this form.
const sourceLabels: Record<string, string> = { both: 'Both', book: 'Book', generated: 'Randomized' };
---
<form class="ws-setup" method="get" action={action}>
  <h1>Build a worksheet</h1>
  <fieldset id="ws-chapters">
    <legend>Chapters</legend>
    {chapters.map((c, i) => (
      <label>
        <input type="checkbox" name="chapter" value={c.slug} data-topics={c.topics.join('|')} checked={i === 0} />
        {`Ch ${c.number} — ${c.title}`}
      </label>
    ))}
  </fieldset>
  <label>Topic
    <select name="topic" id="ws-topic"><option value="">All topics</option></select>
  </label>
  <label>Questions
    <input type="number" name="count" value={WORKSHEET_DEFAULTS.count} min={COUNT_MIN} max={COUNT_MAX} />
  </label>
  <fieldset>
    <legend>Source</legend>
    {SOURCES.map((s) => (
      <label><input type="radio" name="source" value={s} checked={s === WORKSHEET_DEFAULTS.source} /> {sourceLabels[s]}</label>
    ))}
  </fieldset>
  <button type="submit" id="ws-submit">Build worksheet</button>
</form>
<script is:inline>
  (function () {
    var boxes = Array.prototype.slice.call(
      document.querySelectorAll('#ws-chapters input[name="chapter"]'),
    );
    var topicSel = document.getElementById('ws-topic');
    var submit = document.getElementById('ws-submit');
    function refresh() {
      // Topics are the union across the checked chapters, matching what the
      // parser in src/run/worksheet.ts will accept for this selection.
      var checked = boxes.filter(function (b) { return b.checked; });
      var seen = {};
      var topics = [];
      checked.forEach(function (b) {
        (b.getAttribute('data-topics') || '').split('|').filter(Boolean).forEach(function (t) {
          if (!seen[t]) { seen[t] = 1; topics.push(t); }
        });
      });
      // Keep the learner's topic if unchecking a chapter did not remove it.
      var previous = topicSel.value;
      topicSel.innerHTML = '<option value="">All topics</option>';
      topics.forEach(function (t) {
        var o = document.createElement('option');
        o.value = t;
        o.textContent = t;
        topicSel.appendChild(o);
      });
      if (seen[previous]) topicSel.value = previous;
      // A sheet needs at least one chapter; an empty submit would only error.
      submit.disabled = checked.length === 0;
    }
    boxes.forEach(function (b) { b.addEventListener('change', refresh); });
    refresh();
  })();
</script>
<style>
  .ws-setup {
    display: flex; flex-direction: column; gap: var(--space-md);
    max-width: 40ch; margin-inline: auto; padding: var(--space-lg);
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); box-shadow: var(--shadow-sm);
  }
  h1 { font-size: var(--font-size-display); }
  label { display: flex; flex-direction: column; gap: var(--space-xs); color: var(--color-text); font-weight: var(--font-weight-semibold); }
  select, input[type='number'] {
    font: inherit; color: var(--color-text); background: var(--color-surface-raised);
    border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: var(--space-sm);
  }
  select { width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  select:focus-visible, input[type='number']:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  fieldset { display: flex; flex-direction: column; gap: var(--space-sm); padding: var(--space-md); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  legend { padding-inline: var(--space-xs); color: var(--color-text-muted); font-size: var(--font-size-label); }
  fieldset label { flex-direction: row; align-items: center; gap: var(--space-sm); font-weight: var(--font-weight-regular); }
  /* Chapter titles are long enough to wrap in a 40ch column, so the box sits at
     the first line rather than centred against a two-line label. */
  #ws-chapters label { align-items: flex-start; }
  #ws-chapters input { margin-top: 0.2em; flex: none; }
  button[type='submit'] {
    padding: var(--space-sm) var(--space-lg); background: var(--color-accent); color: var(--color-accent-ink);
    border: none; border-radius: var(--radius-pill); font: inherit; font-weight: var(--font-weight-semibold); cursor: pointer;
  }
  button[type='submit']:hover { background: var(--color-accent-hover); }
  button[type='submit']:disabled { background: var(--color-border); color: var(--color-text-muted); cursor: not-allowed; }
</style>
