---
import { joinBase } from '../lib/withBase';

import { navItems } from '../lib/site';

import Sun from './icons/Sun.astro';

import Moon from './icons/Moon.astro';

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={joinBase(base, '')} aria-label="prob·web home">prob<span class="dot">·</span>web</a>

    <nav class="desktop-nav" aria-label="Primary">
      {
        navItems.map((item) =>
          item.children ? (
            <details class="dropdown">
              <summary>{item.label}</summary>

              <div class="menu">
                {item.children.map((c) => (
                  <a href={joinBase(base, c.href)}>{c.label}</a>
                ))}
              </div>
            </details>
          ) : (
            <a class="nav-link" href={joinBase(base, item.href ?? '')}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="header-actions">
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
        <span class="icon-moon"><Moon /></span>

        <span class="icon-sun"><Sun /></span>
      </button>

      <slot name="mobile" />
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');

  const current = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

  if (btn) {
    btn.setAttribute('aria-pressed', String(current() === 'dark'));

    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';

      try {
        localStorage.setItem('prob-theme', next);
      } catch (e) {
        /* private mode — the attribute flip below still applies for the session */
      }

      document.documentElement.dataset.theme = next;

      btn.setAttribute('aria-pressed', String(next === 'dark'));
    });
  }
</script>

<style>
  .site-header {
    position: sticky;

    top: 0;

    z-index: 50;

    background: color-mix(in srgb, var(--color-bg) 85%, transparent);

    backdrop-filter: saturate(1.3) blur(10px);

    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;

    align-items: center;

    justify-content: space-between;

    height: 60px;
  }

  .brand {
    font-weight: var(--font-weight-bold);

    font-size: var(--font-size-heading);

    letter-spacing: -0.03em;

    color: var(--color-text);
  }

  .brand .dot {
    color: var(--color-accent);
  }

  .desktop-nav {
    display: flex;

    align-items: center;

    gap: var(--space-lg);
  }

  .desktop-nav a,
  .dropdown summary {
    color: var(--color-text-muted);

    font-size: var(--font-size-label);

    cursor: pointer;
  }

  .desktop-nav a:hover,
  .dropdown summary:hover {
    color: var(--color-text);
  }

  .dropdown {
    position: relative;
  }

  .dropdown summary {
    list-style: none;
  }

  .dropdown summary::-webkit-details-marker {
    display: none;
  }

  .dropdown[open] .menu {
    display: flex;
  }

  .menu {
    display: none;

    position: absolute;

    top: calc(100% + 8px);

    right: 0;

    flex-direction: column;

    min-width: 160px;

    padding: var(--space-xs);

    background: var(--color-surface-raised);

    border: 1px solid var(--color-border);

    border-radius: var(--radius-md);

    box-shadow: var(--shadow-md);
  }

  .menu a {
    padding: var(--space-sm) var(--space-md);

    border-radius: var(--radius-sm);
  }

  .menu a:hover {
    background: var(--color-accent-soft);
  }

  .header-actions {
    display: flex;

    align-items: center;

    gap: var(--space-xs);
  }

  .theme-toggle {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 40px;

    height: 40px;

    border: 1px solid transparent;

    border-radius: var(--radius-md);

    background: transparent;

    color: var(--color-text-muted);

    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-text);

    background: var(--color-surface);

    border-color: var(--color-border);
  }

  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: inline-flex;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  /* Desktop nav hides under the breakpoint; Task 6 fills the mobile slot. */
  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }
  }
</style>
