---
import { route } from '../lib/routes';

import BellCurve from './BellCurve.astro';

const examHref = route('exam');
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">GJU IE0121 · Walpole 9e</p>

      <h1>Never the same<br />question <span class="accent">twice.</span></h1>

      <p class="lead">A study site for Probability &amp; Statistics — generated practice, worked solutions, and interactive curves.</p>

      <a class="cta" href={examHref}>Start practicing</a>
    </div>

    <BellCurve class="hero-curve" width={300} height={140} />
  </div>

  <style>
    .hero {
      padding-block: var(--space-3xl) var(--space-2xl);
    }

    .hero-inner {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: var(--space-2xl);
    }

    .hero-copy {
      max-width: 36ch;
    }

    .hero h1 {
      font-size: var(--font-size-hero);

      font-weight: var(--font-weight-bold);

      letter-spacing: -0.035em;

      margin-bottom: var(--space-md);
    }

    .accent {
      color: var(--color-accent);
    }

    .lead {
      color: var(--color-text-muted);

      font-size: var(--font-size-heading);

      margin-bottom: var(--space-lg);
    }

    .cta {
      display: inline-block;

      padding: var(--space-sm) var(--space-lg);

      background: var(--color-accent);

      color: var(--color-accent-ink);

      border-radius: var(--radius-pill);

      font-weight: var(--font-weight-semibold);
    }

    .cta:hover {
      background: var(--color-accent-hover);

      color: var(--color-accent-ink);
    }

    .hero-curve {
      flex-shrink: 0;
    }

    @media (max-width: 640px) {
      .hero-curve {
        display: none;
      }
    }
  </style>
</section>
