---
import { route } from '../lib/routes';

import BellCurve from './BellCurve.astro';

interface Props {
  title: string;

  note?: string;
}

const { title, note = 'Coming in the next update.' } = Astro.props;

const homeHref = route();
---

<section class="soon container">
  <BellCurve width={220} height={100} />

  <h1>{title}</h1>

  <p>{note}</p>

  <a href={homeHref}>← Back home</a>

  <style>
    .soon {
      display: flex;

      flex-direction: column;

      align-items: center;

      text-align: center;

      gap: var(--space-md);

      padding-block: var(--space-3xl);
    }

    .soon h1 {
      font-size: var(--font-size-display);
    }

    .soon p {
      color: var(--color-text-muted);

      max-width: 42ch;
    }
  </style>
</section>
