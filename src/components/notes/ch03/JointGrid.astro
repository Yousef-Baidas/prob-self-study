---
// Two-way joint table with cell shading by probability and the row/column
// totals drawn in the margins, so "marginal" reads as literally the margin
// of this grid. Passing `highlightRow` dims every other row, for reuse as
// the "zoom into one row" picture behind a conditional distribution.
interface Props {
  cols: string[];

  rows: string[];

  values: number[][];

  cellText: string[][];

  rowTotalText: string[];

  colTotalText: string[];

  title: string;

  highlightRow?: number;

  cell?: number;
}

const { cols, rows, values, cellText, rowTotalText, colTotalText, title, highlightRow, cell = 64 } = Astro.props;

const headerSize = 40;

const width = headerSize + cell * cols.length + cell;
const height = headerSize + cell * rows.length + cell;

const maxValue = Math.max(...values.flat());

const opacityFor = (value: number) => 0.12 + (value / maxValue) * 0.7;
---

<svg
  width={width}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  role="img"
  aria-label={title}
>
  <title>{title}</title>

  <rect x="0" y="0" width={width} height={height} fill="none" stroke="var(--color-border)" stroke-width="1" aria-hidden="true" />

  {
    cols.map((col, colIndex) => (
      <text
        x={headerSize + cell * colIndex + cell / 2}
        y={headerSize / 2 + 5}
        text-anchor="middle"
        font-size="12"
        fill="var(--color-text)"
      >
        {col}
      </text>
    ))
  }

  {
    rows.map((row, rowIndex) => (
      <text
        x={headerSize / 2}
        y={headerSize + cell * rowIndex + cell / 2 + 4}
        text-anchor="middle"
        font-size="12"
        fill="var(--color-text)"
      >
        {row}
      </text>
    ))
  }

  {
    rows.map((_row, rowIndex) => {
      const dimmed = highlightRow !== undefined && highlightRow !== rowIndex;

      return cols.map((_col, colIndex) => {
        const value = values[rowIndex][colIndex];

        const x = headerSize + cell * colIndex;
        const y = headerSize + cell * rowIndex;

        return (
          <g opacity={dimmed ? 0.25 : 1}>
            <rect
              x={x}
              y={y}
              width={cell}
              height={cell}
              fill="var(--color-accent)"
              fill-opacity={value > 0 ? opacityFor(value) : 0}
              stroke="var(--color-border)"
              stroke-width="1"
            />

            <text x={x + cell / 2} y={y + cell / 2 + 4} text-anchor="middle" font-size="12" fill="var(--color-text)">
              {cellText[rowIndex][colIndex]}
            </text>
          </g>
        );
      });
    })
  }

  {
    colTotalText.map((text, colIndex) => (
      <g>
        <rect
          x={headerSize + cell * colIndex}
          y={headerSize + cell * rows.length}
          width={cell}
          height={cell}
          fill="var(--color-surface)"
          stroke="var(--color-border)"
          stroke-width="1"
        />

        <text
          x={headerSize + cell * colIndex + cell / 2}
          y={headerSize + cell * rows.length + cell / 2 + 4}
          text-anchor="middle"
          font-size="12"
          font-weight="var(--font-weight-semibold)"
          fill="var(--color-text)"
        >
          {text}
        </text>
      </g>
    ))
  }

  {
    rowTotalText.map((text, rowIndex) => (
      <g>
        <rect
          x={headerSize + cell * cols.length}
          y={headerSize + cell * rowIndex}
          width={cell}
          height={cell}
          fill="var(--color-surface)"
          stroke="var(--color-border)"
          stroke-width="1"
        />

        <text
          x={headerSize + cell * cols.length + cell / 2}
          y={headerSize + cell * rowIndex + cell / 2 + 4}
          text-anchor="middle"
          font-size="12"
          font-weight="var(--font-weight-semibold)"
          fill="var(--color-text)"
        >
          {text}
        </text>
      </g>
    ))
  }
</svg>
