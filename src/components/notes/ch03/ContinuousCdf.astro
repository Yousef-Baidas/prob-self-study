---
import { AXIS_PADDING, CHART_WIDTH, plot, samplePoints, scale } from '../chartkit';

// Continuous CDF, with the same two bounds used by the density-and-area figure
// marked as guide lines. The vertical gap between the two dashed lines is the
// height difference between them — the same number as the shaded area next
// door — so it is drawn as a measured bracket with its value on it rather than
// a bare accent tick the reader has to interpret.
interface Props {
  fn: (x: number) => number;

  domain: [number, number];

  markFrom: number;

  markTo: number;

  title: string;

  /** The height difference, e.g. '1/9'. Written onto the bracket. */
  gapLabel?: string;

  /** Name of the quantity along the bottom, e.g. `roundingError`. */
  axisLabel?: string;

  width?: number;

  samples?: number;
}

const { fn, domain, markFrom, markTo, title, gapLabel, axisLabel, width = CHART_WIDTH.continuousCdf, samples = 96 } = Astro.props;

const height = 224;

const p = plot(width, height, { ...AXIS_PADDING, left: 44, bottom: axisLabel ? 48 : 34 });

const points = samplePoints(fn, domain, samples);

const x = scale(domain, [p.left, p.right]);

const y = scale([0, 1], [p.baseline, p.top]);

const curvePoints = points.map((point) => `${x(point.x)},${y(point.y)}`).join(' ');

const marks = [markFrom, markTo].map((at) => ({ at, f: fn(at) }));

// The bracket lives at the right edge, not beside the y axis. The gap it
// measures is the whole point of the figure and is only about a tenth of the
// plot tall — beside the axis it collides with the 0/1 ticks and leaves no
// room for its own label, whereas at the right edge the curve has already
// climbed away and there is clear space to write the value beside it.
const bracketX = p.right - 14;

const gridLines = [0, 0.25, 0.5, 0.75, 1];
---

<svg viewBox={`0 0 ${width} ${height}`} class="c-svg" role="img" aria-label={title}>
  <title>{title}</title>

  {
    gridLines.map((f) => (
      <g aria-hidden="true">
        <line x1={p.left} y1={y(f)} x2={p.right} y2={y(f)} class="c-grid" />

        {(f === 0 || f === 1) && (
          <text x={p.left - 26} y={y(f) + 4} class="c-tick c-end">
            {f}
          </text>
        )}
      </g>
    ))
  }

  <line x1={p.left} y1={p.top} x2={p.left} y2={p.baseline} class="c-axis" aria-hidden="true" />

  <line x1={p.left} y1={p.baseline} x2={p.right} y2={p.baseline} class="c-axis" aria-hidden="true" />

  <text x={p.left - 26} y={p.top - 12} class="c-caps" aria-hidden="true">chance so far</text>

  {
    marks.map((mark) => (
      <g aria-hidden="true">
        <line x1={p.left} y1={y(mark.f)} x2={bracketX} y2={y(mark.f)} class="c-guide" />

        <line x1={x(mark.at)} y1={y(mark.f)} x2={x(mark.at)} y2={p.baseline} class="c-guide" />

        <circle cx={x(mark.at)} cy={y(mark.f)} r="4" class="c-dot" />
      </g>
    ))
  }

  {/* A bracket rather than a bare tick: the figure's claim is that this
      *distance* equals the shaded area next door, and a distance needs two
      ends to be read as one. */}
  <g aria-hidden="true" stroke="var(--color-accent)" stroke-width="2" fill="none">
    <line x1={bracketX} y1={y(marks[0].f)} x2={bracketX} y2={y(marks[1].f)} />

    <line x1={bracketX - 4} y1={y(marks[0].f)} x2={bracketX + 4} y2={y(marks[0].f)} />

    <line x1={bracketX - 4} y1={y(marks[1].f)} x2={bracketX + 4} y2={y(marks[1].f)} />
  </g>

  <polyline points={curvePoints} class="c-data" aria-hidden="true" />

  {
    gapLabel && (
      <text x={bracketX - 10} y={(y(marks[0].f) + y(marks[1].f)) / 2 + 4} class="c-value c-end c-halo" aria-hidden="true">
        {gapLabel}
      </text>
    )
  }

  {
    marks.map((mark) => (
      <text x={x(mark.at)} y={p.baseline + 20} class="c-tick c-mid" aria-hidden="true">
        {mark.at}
      </text>
    ))
  }

  {
    axisLabel && (
      <text x={(p.left + p.right) / 2} y={height - 8} class="c-axis-name c-mid" aria-hidden="true">
        {axisLabel}
      </text>
    )
  }
</svg>
