---
import { AXIS_PADDING, CHART_WIDTH, plot, scale } from '../chartkit';

// Discrete CDF staircase. `steps` gives the jump points in x order; the
// segment before step i sits at cumulative height `steps[i - 1].f` (0 for the
// first) and jumps to `steps[i].f` exactly at `steps[i].x` — a closed circle
// marks the value the running total actually takes there, an open circle marks
// the height it approaches from the left but never reaches.
//
// The vertical risers are drawn faintly rather than omitted: without them the
// treads read as four unrelated line segments, and the jump — which is the
// whole content of the figure — is invisible.
interface Step {
  x: number;

  f: number;

  label: string;
}

interface Props {
  steps: Step[];

  title: string;

  /** Name of the quantity along the bottom, e.g. `airbagCount`. */
  axisLabel?: string;

  width?: number;
}

const { steps, title, axisLabel, width = CHART_WIDTH.cdfStep } = Astro.props;

const height = 224;

const p = plot(width, height, { ...AXIS_PADDING, bottom: axisLabel ? 48 : 34 });

if (steps.length === 0) {
  // Reading steps[0].x below would throw during the static build and take the
  // whole page down, which is a poor trade for a figure with nothing to draw.
  throw new Error('CdfStep needs at least one step');
}

const xMin = steps[0].x - 1;

const xMax = steps[steps.length - 1].x + 1;

const x = scale([xMin, xMax], [p.left, p.right]);

const y = scale([0, 1], [p.baseline, p.top]);

const treads = steps.map((step, index) => {
  const prevF = index === 0 ? 0 : steps[index - 1].f;

  const startX = index === 0 ? xMin : steps[index - 1].x;

  return {
    x1: x(startX),
    x2: x(step.x),
    y: y(prevF),
    riserTo: y(step.f),
    label: step.label,
    labelX: x(step.x),
  };
});

const lastStep = steps[steps.length - 1];

const gridLines = [0, 0.25, 0.5, 0.75, 1];
---

<svg viewBox={`0 0 ${width} ${height}`} class="c-svg" role="img" aria-label={title}>
  <title>{title}</title>

  {
    gridLines.map((f) => (
      <g aria-hidden="true">
        <line x1={p.left} y1={y(f)} x2={p.right} y2={y(f)} class="c-grid" />

        {(f === 0 || f === 1) && (
          <text x={p.left - 8} y={y(f) + 4} class="c-tick c-end">
            {f}
          </text>
        )}
      </g>
    ))
  }

  <line x1={p.left} y1={p.top} x2={p.left} y2={p.baseline} class="c-axis" aria-hidden="true" />

  <line x1={p.left} y1={p.baseline} x2={p.right} y2={p.baseline} class="c-axis" aria-hidden="true" />

  <text x={p.left} y={p.top - 12} class="c-caps" aria-hidden="true">running total</text>

  {
    treads.map((tread) => (
      <g aria-hidden="true">
        <line x1={tread.x2} y1={tread.y} x2={tread.x2} y2={tread.riserTo} class="c-guide-accent" />

        <line x1={tread.x1} y1={tread.y} x2={tread.x2} y2={tread.y} class="c-data" />

        <circle cx={tread.x2} cy={tread.y} r="4.5" class="c-dot-open" />

        <circle cx={tread.x2} cy={tread.riserTo} r="4.5" class="c-dot" />

        <text x={tread.labelX} y={p.baseline + 20} class="c-tick c-mid">
          {tread.label}
        </text>
      </g>
    ))
  }

  <line x1={x(lastStep.x)} y1={y(lastStep.f)} x2={p.right} y2={y(lastStep.f)} class="c-data" aria-hidden="true" />

  {
    axisLabel && (
      <text x={(p.left + p.right) / 2} y={height - 8} class="c-axis-name c-mid" aria-hidden="true">
        {axisLabel}
      </text>
    )
  }
</svg>
