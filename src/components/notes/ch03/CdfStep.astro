---
// Discrete CDF staircase. `steps` gives the jump points in x order; the
// segment before step i sits at cumulative height `steps[i - 1].f` (0 for the
// first) and jumps to `steps[i].f` exactly at `steps[i].x` — a closed circle
// marks the value F actually takes there, an open circle marks the height it
// approaches from the left but never reaches.
interface Step {
  x: number;

  f: number;

  label: string;
}

interface Props {
  steps: Step[];

  title: string;

  width?: number;

  height?: number;
}

const { steps, title, width = 320, height = 200 } = Astro.props;

const padding = { top: 24, right: 24, bottom: 32, left: 36 };

const chartWidth = width - padding.left - padding.right;
const chartHeight = height - padding.top - padding.bottom;

const xMin = steps[0].x - 1;
const xMax = steps[steps.length - 1].x + 1;

const xScale = (x: number) => padding.left + ((x - xMin) / (xMax - xMin)) * chartWidth;
const yScale = (f: number) => padding.top + (1 - f) * chartHeight;

const segments = steps.map((step, index) => {
  const prevF = index === 0 ? 0 : steps[index - 1].f;

  const startX = index === 0 ? xMin : steps[index - 1].x;

  return {
    x1: xScale(startX),
    x2: xScale(step.x),
    y: yScale(prevF),
    openCircle: { cx: xScale(step.x), cy: yScale(prevF) },
    closedCircle: { cx: xScale(step.x), cy: yScale(step.f) },
    label: step.label,
    labelX: xScale(step.x),
  };
});

const lastStep = steps[steps.length - 1];

const finalSegment = {
  x1: xScale(lastStep.x),
  x2: xScale(xMax),
  y: yScale(lastStep.f),
};
---

<svg
  width={width}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  role="img"
  aria-label={title}
>
  <title>{title}</title>

  <line
    x1={padding.left}
    y1={padding.top + chartHeight}
    x2={width - padding.right}
    y2={padding.top + chartHeight}
    stroke="var(--color-border)"
    stroke-width="1"
    aria-hidden="true"
  />

  <line
    x1={padding.left}
    y1={padding.top}
    x2={padding.left}
    y2={padding.top + chartHeight}
    stroke="var(--color-border)"
    stroke-width="1"
    aria-hidden="true"
  />

  <text x={padding.left - 8} y={padding.top + 4} text-anchor="end" font-size="11" fill="var(--color-text-muted)">
    1
  </text>

  <text x={padding.left - 8} y={padding.top + chartHeight + 4} text-anchor="end" font-size="11" fill="var(--color-text-muted)">
    0
  </text>

  {
    segments.map((segment) => (
      <g>
        <line
          x1={segment.x1}
          y1={segment.y}
          x2={segment.x2}
          y2={segment.y}
          stroke="var(--color-accent)"
          stroke-width="2.5"
        />

        <circle cx={segment.openCircle.cx} cy={segment.openCircle.cy} r="4" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="2" />

        <circle cx={segment.closedCircle.cx} cy={segment.closedCircle.cy} r="4" fill="var(--color-accent)" />

        <text x={segment.labelX} y={padding.top + chartHeight + 18} text-anchor="middle" font-size="12" fill="var(--color-text-muted)">
          {segment.label}
        </text>
      </g>
    ))
  }

  <line
    x1={finalSegment.x1}
    y1={finalSegment.y}
    x2={finalSegment.x2}
    y2={finalSegment.y}
    stroke="var(--color-accent)"
    stroke-width="2.5"
  />
</svg>
