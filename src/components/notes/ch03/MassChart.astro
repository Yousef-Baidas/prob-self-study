---
// Probability mass bar chart: one bar per outcome, height proportional to
// f(x). Geometry is derived from `bars` so the picture can never drift from
// the worked example that quotes the same numbers in prose.
interface Bar {
  x: string;

  p: number;

  label: string;
}

interface Props {
  bars: Bar[];

  title: string;

  width?: number;

  height?: number;
}

const { bars, title, width = 320, height = 200 } = Astro.props;

const padding = { top: 24, right: 16, bottom: 32, left: 16 };

const chartWidth = width - padding.left - padding.right;
const chartHeight = height - padding.top - padding.bottom;

const maxP = Math.max(...bars.map((bar) => bar.p));

// Headroom above the tallest bar so its value label never clips the top edge.
const domainMax = maxP * 1.25;

const barGap = 16;
const barWidth = (chartWidth - barGap * (bars.length - 1)) / bars.length;

const plotted = bars.map((bar, index) => {
  const barHeight = (bar.p / domainMax) * chartHeight;

  const xPos = padding.left + index * (barWidth + barGap);
  const yPos = padding.top + (chartHeight - barHeight);

  return { ...bar, xPos, yPos, barHeight };
});

const baseline = padding.top + chartHeight;
---

<svg
  width={width}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  role="img"
  aria-label={title}
>
  <title>{title}</title>

  <line
    x1={padding.left}
    y1={baseline}
    x2={width - padding.right}
    y2={baseline}
    stroke="var(--color-border)"
    stroke-width="1"
    aria-hidden="true"
  />

  {
    plotted.map((bar) => (
      <g>
        <rect
          x={bar.xPos}
          y={bar.yPos}
          width={barWidth}
          height={bar.barHeight}
          fill="var(--color-accent-soft)"
          stroke="var(--color-accent)"
          stroke-width="1.5"
        />

        <text
          x={bar.xPos + barWidth / 2}
          y={bar.yPos - 6}
          text-anchor="middle"
          font-size="11"
          fill="var(--color-text)"
        >
          {bar.label}
        </text>

        <text
          x={bar.xPos + barWidth / 2}
          y={baseline + 18}
          text-anchor="middle"
          font-size="12"
          fill="var(--color-text-muted)"
        >
          {bar.x}
        </text>
      </g>
    ))
  }
</svg>
