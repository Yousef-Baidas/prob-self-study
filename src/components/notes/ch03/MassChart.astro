---
import Hatch from '../Hatch.astro';

import { AXIS_PADDING, CHART_WIDTH, plot, uid } from '../chartkit';

// Probability mass bar chart: one bar per outcome, height proportional to the
// chance of that outcome. Geometry is derived from `bars`, so the picture can
// never drift from the worked example that quotes the same numbers in prose.
interface Bar {
  x: string;

  p: number;

  label: string;
}

interface Props {
  bars: Bar[];

  title: string;

  /** Name of the quantity along the bottom, e.g. `airbagCount`. */
  axisLabel?: string;

  width?: number;
}

const { bars, title, axisLabel, width = CHART_WIDTH.massChart } = Astro.props;

const height = 224;

const p = plot(width, height, { ...AXIS_PADDING, bottom: axisLabel ? 48 : 34 });

// `|| 1` because a distribution whose bars are all zero would divide every
// height and gridline by zero, and `height="NaN"` is not a length — the chart
// would come out empty rather than flat.
const maxP = Math.max(...bars.map((bar) => bar.p)) || 1;

// Headroom above the tallest bar so its value label never clips the top edge.
const domainMax = maxP * 1.25;

const barGap = 20;

const barWidth = (p.innerWidth - barGap * (bars.length - 1)) / bars.length;

const hatchId = uid('mass-hatch');

const plotted = bars.map((bar, index) => {
  const barHeight = (bar.p / domainMax) * p.innerHeight;

  return {
    ...bar,
    xPos: p.left + index * (barWidth + barGap),
    yPos: p.baseline - barHeight,
    barHeight,
  };
});

// Quarter gridlines, the last of which sits at the tallest bar's own height, so its label reads as a level
// rather than a number floating above a rectangle.
const gridLines = [0.25, 0.5, 0.75, 1].map((f) => ({
  value: f,
  y: p.baseline - (f * maxP * p.innerHeight) / domainMax,
}));
---

<svg viewBox={`0 0 ${width} ${height}`} class="c-svg" role="img" aria-label={title}>
  <title>{title}</title>

  <Hatch id={hatchId} spacing={6} />

  {gridLines.map((line) => <line x1={p.left} y1={line.y} x2={p.right} y2={line.y} class="c-grid" aria-hidden="true" />)}

  <line x1={p.left} y1={p.top} x2={p.left} y2={p.baseline} class="c-axis" aria-hidden="true" />

  <line x1={p.left} y1={p.baseline} x2={p.right} y2={p.baseline} class="c-axis" aria-hidden="true" />

  <text x={p.left} y={p.top - 12} class="c-caps" aria-hidden="true">chance</text>

  {
    plotted.map((bar) => (
      <g aria-hidden="true">
        <rect
          x={bar.xPos}
          y={bar.yPos}
          width={barWidth}
          height={bar.barHeight}
          fill={`url(#${hatchId})`}
          stroke="var(--color-accent)"
          stroke-width="1.5"
        />

        <text x={bar.xPos + barWidth / 2} y={bar.yPos - 8} class="c-value c-mid c-halo">
          {bar.label}
        </text>

        <text x={bar.xPos + barWidth / 2} y={p.baseline + 20} class="c-tick c-mid">
          {bar.x}
        </text>
      </g>
    ))
  }

  {
    axisLabel && (
      <text x={(p.left + p.right) / 2} y={height - 8} class="c-axis-name c-mid" aria-hidden="true">
        {axisLabel}
      </text>
    )
  }
</svg>
