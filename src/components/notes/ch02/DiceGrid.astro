---
import Hatch from '../Hatch.astro';

import { CHART_WIDTH, uid } from '../chartkit';

// The 6x6 grid of two-dice outcomes. Data-driven so the same component serves
// both a plain "36 equally likely outcomes" figure (§2.1) and a figure
// highlighting one event's outcomes (§2.6) — the geometry is never hand-drawn,
// so it cannot drift from the prose.
//
// Both axes are named, not just numbered: the whole reason (2, 5) and (5, 2)
// are different cells is that one axis is the first die and the other the
// second, and an unlabelled grid leaves the reader to guess that.
interface Props {
  title: string;

  // 1-indexed [firstDie, secondDie] pairs to fill with the event colour.
  highlight?: [number, number][];

  // 1-indexed [firstDie, secondDie] pairs to ring, for one outcome singled
  // out inside a highlighted set.
  emphasize?: [number, number][];
}

const { title, highlight = [], emphasize = [] } = Astro.props;

const width = CHART_WIDTH.diceGrid;

const originX = 44;

const originY = 42;

const faces = [1, 2, 3, 4, 5, 6];

// Cell size follows from the published width rather than the other way round,
// so the number the `<Figure>` renders at and the number the grid is drawn to
// cannot drift apart.
const gridSize = width - originX - 6;

const cell = gridSize / faces.length;

const height = originY + gridSize + 6;

const hatchId = uid('dice-hatch');

const isIn = (list: [number, number][], a: number, b: number) => list.some(([x, y]) => x === a && y === b);
---

<svg viewBox={`0 0 ${width} ${height}`} class="c-svg" role="img" aria-label={title}>
  <title>{title}</title>

  <Hatch id={hatchId} spacing={8} />

  <text x={originX} y="12" class="c-axis-name" aria-hidden="true">second die →</text>

  <text
    x="12"
    y={originY + gridSize / 2}
    class="c-axis-name c-mid"
    transform={`rotate(-90 12 ${originY + gridSize / 2})`}
    aria-hidden="true">first die →</text
  >

  {
    faces.map((f, i) => (
      <text x={originX + i * cell + cell / 2} y={originY - 10} class="c-tick c-mid" aria-hidden="true">
        {f}
      </text>
    ))
  }

  {
    faces.map((f, i) => (
      <text x={originX - 12} y={originY + i * cell + cell / 2 + 4} class="c-tick c-end" aria-hidden="true">
        {f}
      </text>
    ))
  }

  {
    faces.map((a, i) =>
      faces.map((b, j) => {
        const x = originX + j * cell;

        const y = originY + i * cell;

        const on = isIn(highlight, a, b);

        const marked = isIn(emphasize, a, b);

        return (
          <g aria-hidden="true">
            <rect
              x={x}
              y={y}
              width={cell}
              height={cell}
              fill={on ? `url(#${hatchId})` : 'transparent'}
              stroke={on ? 'var(--color-accent)' : 'var(--color-chart-grid)'}
              stroke-width={on ? 1.25 : 1}
            />

            {marked && (
              <>
                <rect
                  x={x + 3}
                  y={y + 3}
                  width={cell - 6}
                  height={cell - 6}
                  fill="none"
                  stroke="var(--color-accent)"
                  stroke-width="2.5"
                />

                <text x={x + cell / 2} y={y + cell / 2 + 4} class="c-value c-mid c-halo">
                  {a},{b}
                </text>
              </>
            )}
          </g>
        );
      }),
    )
  }

  <rect
    x={originX}
    y={originY}
    width={gridSize}
    height={gridSize}
    fill="none"
    stroke="var(--color-border)"
    stroke-width="1.25"
    aria-hidden="true"
  />
</svg>
