---
import { CHART_WIDTH } from '../chartkit';

// Two-stage probability tree. Branch probabilities and leaf products are
// passed in as already-formatted strings (matching the prose exactly) rather
// than recomputed here — only the geometry is derived, so the figure can never
// show a rounding that disagrees with the worked example.
//
// The branches are drawn as curves rather than straight segments: a straight
// fan from a single point reads as a starburst, while a curve that leaves the
// node horizontally and arrives horizontally reads as a path you follow, which
// is exactly the instruction the caption gives ("multiply along each path").
interface Leaf {
  label: string;

  prob: string;

  product: string;
}

interface Branch {
  label: string;

  prob: string;

  leaves: Leaf[];
}

interface Props {
  title: string;

  root: string;

  branches: Branch[];

  /** Caps headers over the two stages, e.g. ['which machine', 'defective?']. */
  columns?: [string, string];
}

const { title, root, branches, columns } = Astro.props;

const rowHeight = 36;

const headerHeight = columns ? 30 : 8;

const x0 = 14;

const x1 = 150;

const x2 = 330;

// The second-stage probability sits near the leaf rather than midway along its
// curve: midway puts it directly on top of the first-stage label, which runs
// from x1 rightwards.
const stageTwoProbX = x2 - 32;

const width = CHART_WIDTH.probTree;

let row = 0;

const laidOut = branches.map((branch) => {
  const firstRow = row;

  const leafRows = branch.leaves.map((leaf) => {
    const y = headerHeight + row * rowHeight + rowHeight / 2;

    row += 1;

    return { ...leaf, y };
  });

  const lastRow = row - 1;

  const branchY = headerHeight + ((firstRow + lastRow) / 2) * rowHeight + rowHeight / 2;

  return { ...branch, leafRows, branchY };
});

const totalRows = row;

const height = headerHeight + totalRows * rowHeight + 12;

const rootY = headerHeight + (totalRows * rowHeight) / 2;

// Leaves horizontally, curves vertically: control points sit a third of the
// way across so the bend happens in the middle of the run, not at the nodes.
const link = (ax: number, ay: number, bx: number, by: number) => {
  const dx = (bx - ax) * 0.42;

  return `M ${ax},${ay} C ${ax + dx},${ay} ${bx - dx},${by} ${bx},${by}`;
};
---

<svg viewBox={`0 0 ${width} ${height}`} class="c-svg" role="img" aria-label={title}>
  <title>{title}</title>

  {
    columns && (
      <g aria-hidden="true">
        <text x={x1 + 6} y="14" class="c-caps">
          {columns[0]}
        </text>

        <text x={x2 + 6} y="14" class="c-caps">
          {columns[1]}
        </text>

        <line x1="0" y1="22" x2={width} y2="22" class="c-grid" />
      </g>
    )
  }

  <g aria-hidden="true" fill="none" stroke="var(--color-chart-grid)" stroke-width="1.5">
    {laidOut.map((branch) => (
      <path d={link(x0, rootY, x1, branch.branchY)} />
    ))}

    {laidOut.map((branch) => branch.leafRows.map((leaf) => <path d={link(x1, branch.branchY, x2, leaf.y)} />))}
  </g>

  <circle cx={x0} cy={rootY} r="4.5" class="c-dot" aria-hidden="true" />

  <text x={x0 - 2} y={rootY - 12} class="c-caps" aria-hidden="true">{root}</text>

  {
    laidOut.map((branch) => (
      <>
        <text x={(x0 + x1) / 2} y={(rootY + branch.branchY) / 2 - 5} class="c-value c-mid c-halo" aria-hidden="true">
          {branch.prob}
        </text>

        <circle cx={x1} cy={branch.branchY} r="3.5" fill="var(--color-chart-ink)" aria-hidden="true" />

        <text x={x1 + 8} y={branch.branchY - 7} class="c-label" aria-hidden="true">
          {branch.label}
        </text>

        {branch.leafRows.map((leaf) => (
          <>
            <text x={stageTwoProbX} y={(branch.branchY + leaf.y) / 2 - 5} class="c-value c-mid c-halo" aria-hidden="true">
              {leaf.prob}
            </text>

            <circle cx={x2} cy={leaf.y} r="3" class="c-dot-muted" aria-hidden="true" />

            <text x={x2 + 8} y={leaf.y - 5} class="c-label" aria-hidden="true">
              {leaf.label}
            </text>

            <text x={x2 + 8} y={leaf.y + 11} class="c-value c-value-muted" aria-hidden="true">
              {leaf.product}
            </text>
          </>
        ))}
      </>
    ))
  }
</svg>
