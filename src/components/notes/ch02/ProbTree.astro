---
// Two-stage probability tree. Branch probabilities and leaf products are
// passed in as already-formatted strings (matching the prose exactly)
// rather than recomputed here — only the geometry is derived, so the
// figure can never show a rounding that disagrees with the worked example.
interface Leaf {
  label: string;

  prob: string;

  product: string;
}

interface Branch {
  label: string;

  prob: string;

  leaves: Leaf[];
}

interface Props {
  title: string;

  root: string;

  branches: Branch[];
}

const { title, root, branches } = Astro.props;

const rowHeight = 30;
const x0 = 8;
const x1 = 130;
// Wide enough that a long first-stage label ("machine1 (30%)") ends before the
// second-stage probability that sits between the two columns.
const x2 = 330;

let row = 0;
const laidOut = branches.map((branch) => {
  const firstRow = row;
  const leafRows = branch.leaves.map((leaf) => {
    const y = row * rowHeight + rowHeight / 2;
    row += 1;
    return { ...leaf, y };
  });
  const lastRow = row - 1;
  const branchY = ((firstRow + lastRow) / 2) * rowHeight + rowHeight / 2;
  return { ...branch, leafRows, branchY };
});

const totalRows = row;
const height = totalRows * rowHeight + 20;
const rootY = height / 2;
const width = x2 + 130;
---

<svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title}>
  <title>{title}</title>

  <g aria-hidden="true" class="tree-lines">
    {laidOut.map((branch) => (
      <line x1={x0} y1={rootY} x2={x1} y2={branch.branchY} />
    ))}

    {laidOut.map((branch) =>
      branch.leafRows.map((leaf) => <line x1={x1} y1={branch.branchY} x2={x2} y2={leaf.y} />),
    )}
  </g>

  <circle cx={x0} cy={rootY} r="4" fill="var(--color-accent)" aria-hidden="true" />

  <text x={x0} y={rootY - 10} class="tree-label tree-root" aria-hidden="true">{root}</text>

  {laidOut.map((branch) => (
    <>
      <text x={(x0 + x1) / 2} y={(rootY + branch.branchY) / 2 - 6} class="tree-prob" aria-hidden="true">{branch.prob}</text>

      <text x={x1 + 6} y={branch.branchY - 6} class="tree-label" aria-hidden="true">{branch.label}</text>

      {branch.leafRows.map((leaf) => (
        <>
          <text x={x2 - 40} y={(branch.branchY + leaf.y) / 2 - 6} class="tree-prob" aria-hidden="true">{leaf.prob}</text>

          <text x={x2 + 6} y={leaf.y - 6} class="tree-label" aria-hidden="true">{leaf.label}</text>

          <text x={x2 + 6} y={leaf.y + 8} class="tree-product" aria-hidden="true">{leaf.product}</text>
        </>
      ))}
    </>
  ))}

  <style>
    .tree-lines line {
      stroke: var(--color-border);

      stroke-width: 1.5;
    }

    text.tree-label {
      font-size: 13px;

      font-family: var(--font-sans);

      fill: var(--color-text);
    }

    text.tree-root {
      fill: var(--color-text-muted);
    }

    text.tree-prob {
      font-size: 12px;

      font-family: var(--font-mono);

      fill: var(--color-accent);

      text-anchor: middle;
    }

    text.tree-product {
      font-size: 12px;

      font-family: var(--font-mono);

      fill: var(--color-text-muted);
    }
  </style>
</svg>
