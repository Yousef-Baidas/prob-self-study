---
import { mean, median, iqrStats } from './stats';

import { CHART_WIDTH, padDomain, round, scale, ticks } from '../chartkit';

// One dot per observation on a number line, with the mean and the median
// marked as two distinct voices: the mean in accent (the figure's subject),
// the median in ink (what it is being compared against).
interface Props {
  values: number[];

  title: string;

  unit?: string;

  width?: number;
}

const { values, title, unit = '', width = CHART_WIDTH.dotPlot } = Astro.props;

const sorted = [...values].sort((a, b) => a - b);

const m = mean(sorted);

const med = median(sorted);

const { lowerFence, upperFence } = iqrStats(sorted);

const marginX = 26;

const domain = padDomain(sorted[0], sorted[sorted.length - 1]);

const x = scale(domain, [marginX, width - marginX]);

const baselineY = 122;

const dotRadius = 5.5;

const dotStep = 13;

// Dots stack upward whenever they would *overlap*, not only when the values
// are exactly equal. The pile-up is the whole point of a dot plot, and equality
// is the wrong test for it: one extreme value stretches the scale until nine
// distinct readings sit a few pixels apart and smear into a single blob, which
// is precisely the case this chart illustrates.
const placed: { cx: number; depth: number }[] = [];

const points = sorted.map((v) => {
  const cx = x(v);

  // The lowest row with nothing already sitting within a dot's width of this
  // position — so a cluster stacks into a column rather than a diagonal.
  let depth = 0;

  while (placed.some((p) => p.depth === depth && Math.abs(p.cx - cx) < dotRadius * 2 + 1.5)) {
    depth += 1;
  }

  placed.push({ cx, depth });

  return {
    v,
    cx,
    cy: baselineY - dotRadius - 3 - depth * dotStep,
    isOutlier: v < lowerFence || v > upperFence,
  };
});

const withUnit = (v: number) => (unit ? `${v} ${unit}` : `${v}`);

const axisTicks = ticks(domain, 6);

// Mean on the upper tier, median below it: the mean is the value the caption
// is about, so it gets the position the eye reaches first.
const markers = [
  { at: m, text: `mean ${withUnit(round(m))}`, y: 20, tone: 'c-value', guide: 'c-guide-accent' },
  { at: med, text: `median ${withUnit(round(med))}`, y: 46, tone: 'c-value c-value-ink', guide: 'c-guide-ink' },
];

const height = 182;

// An outlier is a diamond, not just a differently-coloured dot: accent versus
// muted puts the entire distinction in hue, which is the one channel a
// colour-blind reader does not have. The shape carries it, and the legend
// below names it outright.
const diamondR = dotRadius * 1.35;

const diamond = (cx: number, cy: number) =>
  `${cx},${cy - diamondR} ${cx + diamondR},${cy} ${cx},${cy + diamondR} ${cx - diamondR},${cy}`;
---

<svg viewBox={`0 0 ${width} ${height}`} class="c-svg" role="img" aria-label={title}>
  <title>{title}</title>

  {
    markers.map((marker) => (
      <line
        x1={x(marker.at)}
        y1={marker.y + 6}
        x2={x(marker.at)}
        y2={baselineY}
        class={marker.guide}
        aria-hidden="true"
      />
    ))
  }

  <line x1={marginX} y1={baselineY} x2={width - marginX} y2={baselineY} class="c-axis" aria-hidden="true" />

  {
    axisTicks.map((t) => (
      <g aria-hidden="true">
        <line x1={x(t)} y1={baselineY} x2={x(t)} y2={baselineY + 5} class="c-grid" />

        <text x={x(t)} y={baselineY + 20} class="c-tick c-mid">
          {t}
        </text>
      </g>
    ))
  }

  {
    points.map((p) =>
      p.isOutlier ? (
        <polygon points={diamond(p.cx, p.cy)} class="c-dot" aria-hidden="true" />
      ) : (
        <circle cx={p.cx} cy={p.cy} r={dotRadius} class="c-dot-muted" aria-hidden="true" />
      ),
    )
  }

  {
    points.some((p) => p.isOutlier) && (
      <g aria-hidden="true">
        <polygon points={diamond(marginX + 5, height - 12)} class="c-dot" />

        <text x={marginX + 15} y={height - 8} class="c-tick">
          outlier
        </text>
      </g>
    )
  }

  {
    markers.map((marker) => (
      <text x={x(marker.at)} y={marker.y} class={`${marker.tone} c-mid c-halo`} aria-hidden="true">
        {marker.text}
      </text>
    ))
  }

</svg>
