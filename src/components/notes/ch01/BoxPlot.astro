---
import { iqrStats } from './stats';

import Hatch from '../Hatch.astro';

import { CHART_WIDTH, padDomain, round, scale, ticks, uid } from '../chartkit';

// Box-and-whisker plot. Two voices: the box and its median are the data
// (accent), the fence rule is the reference the data is judged against (ink).
//
// The fence span is drawn as a bracket *under* the axis rather than a filled
// band behind the box. A band works out to a slab wider and taller than the
// box plot itself, which puts the reference in front of the thing it is meant
// to judge; a bracket says "this far and no further" and stays out of the way.
interface Props {
  values: number[];

  title: string;

  unit?: string;

  width?: number;
}

const { values, title, unit = '', width = CHART_WIDTH.boxPlot } = Astro.props;

const sorted = [...values].sort((a, b) => a - b);

const { q1, q2, q3, lowerFence, upperFence } = iqrStats(sorted);

const inFence = sorted.filter((v) => v >= lowerFence && v <= upperFence);

const whiskerLow = inFence[0];

const whiskerHigh = inFence[inFence.length - 1];

const outliers = sorted.filter((v) => v < lowerFence || v > upperFence);

const marginX = 26;

const domain = padDomain(
  Math.min(sorted[0], lowerFence),
  Math.max(sorted[sorted.length - 1], upperFence),
  0.06,
);

const x = scale(domain, [marginX, width - marginX]);

const axisTicks = ticks(domain, 6);

const baselineY = 128;

const boxHalf = 24;

const capHalf = 10;

const bracketY = 188;

const height = 216;

const hatchId = uid('box-hatch');

const withUnit = (v: number) => (unit ? `${v} ${unit}` : `${v}`);

// Q1, the median and Q3 sit close together whenever an outlier stretches the
// scale, so their labels get their own vertical tier and a leader line rather
// than a shared row they would overlap in.
const quartileLabels = [
  { value: q1, text: `Q1 ${withUnit(round(q1))}`, tier: 0, accent: false },
  { value: q2, text: `median ${withUnit(round(q2))}`, tier: 1, accent: true },
  { value: q3, text: `Q3 ${withUnit(round(q3))}`, tier: 2, accent: false },
];

const tierY = (tier: number) => baselineY - boxHalf - 12 - tier * 24;
---

<svg viewBox={`0 0 ${width} ${height}`} class="c-svg" role="img" aria-label={title}>
  <title>{title}</title>

  <Hatch id={hatchId} />

  {
    axisTicks.map((tick) => (
      <g aria-hidden="true">
        <line x1={x(tick)} y1={baselineY + boxHalf + 6} x2={x(tick)} y2={baselineY + boxHalf + 11} class="c-grid" />

        <text x={x(tick)} y={baselineY + boxHalf + 22} class="c-tick c-mid">
          {tick}
        </text>
      </g>
    ))
  }

  <line x1={marginX} y1={baselineY + boxHalf + 6} x2={width - marginX} y2={baselineY + boxHalf + 6} class="c-grid" aria-hidden="true" />

  {/* The fence span, as a bracket beneath the scale. */}
  <g aria-hidden="true">
    <line x1={x(lowerFence)} y1={bracketY} x2={x(upperFence)} y2={bracketY} class="c-bracket-ink" />

    {[lowerFence, upperFence].map((fence) => (
      <line x1={x(fence)} y1={bracketY - 6} x2={x(fence)} y2={bracketY + 6} class="c-bracket-ink" />
    ))}

    <text x={(x(lowerFence) + x(upperFence)) / 2} y={bracketY + 20} class="c-caps c-mid c-halo">
      inside the fences
    </text>
  </g>

  {/* Where each fence falls on the scale, carried up through the plot so a
      point can be read as inside or outside it at a glance. */}
  {
    [lowerFence, upperFence].map((fence) => (
      <line x1={x(fence)} y1={baselineY - boxHalf - 4} x2={x(fence)} y2={baselineY + boxHalf + 4} class="c-guide-ink" aria-hidden="true" />
    ))
  }

  <line x1={x(whiskerLow)} y1={baselineY} x2={x(q1)} y2={baselineY} class="c-connector" aria-hidden="true" />

  <line x1={x(q3)} y1={baselineY} x2={x(whiskerHigh)} y2={baselineY} class="c-connector" aria-hidden="true" />

  {
    [whiskerLow, whiskerHigh].map((v) => (
      <line x1={x(v)} y1={baselineY - capHalf} x2={x(v)} y2={baselineY + capHalf} class="c-connector" aria-hidden="true" />
    ))
  }

  <rect
    x={x(q1)}
    y={baselineY - boxHalf}
    width={x(q3) - x(q1)}
    height={boxHalf * 2}
    fill={`url(#${hatchId})`}
    stroke="var(--color-accent)"
    stroke-width="1.5"
    aria-hidden="true"
  />

  <line
    x1={x(q2)}
    y1={baselineY - boxHalf}
    x2={x(q2)}
    y2={baselineY + boxHalf}
    stroke="var(--color-accent)"
    stroke-width="3"
    aria-hidden="true"
  />

  {
    outliers.map((v) => (
      <g aria-hidden="true">
        <circle cx={x(v)} cy={baselineY} r="10" fill="none" stroke="var(--color-accent)" stroke-width="1" opacity="0.5" />

        <circle cx={x(v)} cy={baselineY} r="5.5" class="c-dot" />

        <line x1={x(v)} y1={baselineY - 14} x2={x(v)} y2={tierY(0) + 4} class="c-leader" />

        <text x={x(v)} y={tierY(0)} class="c-value c-mid c-halo">
          outlier {withUnit(v)}
        </text>
      </g>
    ))
  }

  {
    quartileLabels.map((label) => (
      <g aria-hidden="true">
        <line x1={x(label.value)} y1={baselineY - boxHalf} x2={x(label.value)} y2={tierY(label.tier) + 4} class="c-leader" />

        <text
          x={x(label.value)}
          y={tierY(label.tier)}
          class={`c-value c-mid c-halo${label.accent ? '' : ' c-value-muted'}`}
        >
          {label.text}
        </text>
      </g>
    ))
  }
</svg>
