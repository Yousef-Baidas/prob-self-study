---
import Hatch from '../Hatch.astro';

import { CHART_WIDTH, samplePoints, scale, uid } from '../chartkit';

// Two panels, side by side: the survival curve S(x) = e^(-λx) from t1
// onward on the left, hatched over [t1, t1+t2]; the *same* curve replotted
// from 0 on the right, hatched over [0, t2]. The point of this figure is
// that the two panels are literally the same curve — S(t1+u)/S(t1) = S(u)
// exactly, for the exponential — so the conditional tail beyond t1 is not
// merely similar in shape to the whole curve, it IS the whole curve, just
// relabelled. Same idiom as Standardization.astro: shared height, one
// connector arrow, matching area labels.
interface Props {
  title: string;

  lambda: number;

  t1: number;

  t2: number;

  areaLabel?: string;

  axisLabelX?: string;

  width?: number;

  samples?: number;
}

const {
  title,
  lambda,
  t1,
  t2,
  areaLabel,
  axisLabelX = 'x',
  width = CHART_WIDTH.memoryless,
  samples = 96,
} = Astro.props;

const height = 220;

const gap = 56;

const panelWidth = (width - gap) / 2;

const padding = { top: 40, right: 16, bottom: 40, left: 16 };

const survival = (x: number) => Math.exp(-lambda * x);

const tailEnd = t1 + t2 + 1 / lambda;

const leftDomain: [number, number] = [0, tailEnd];

const rightDomain: [number, number] = [0, tailEnd - t1];

function panel(domain: [number, number], from: number, to: number, originX: number) {
  const points = samplePoints(survival, domain, samples);

  const px = scale(domain, [originX + padding.left, originX + panelWidth - padding.right]);

  const py = scale([0, 1.1], [height - padding.bottom, padding.top]);

  const curvePoints = points.map((point) => `${px(point.x)},${py(point.y)}`).join(' ');

  const shadeXs = points.filter((point) => point.x >= from && point.x <= to);

  const shadePath =
    `M ${px(from)},${height - padding.bottom} ` +
    `L ${px(from)},${py(survival(from))} ` +
    shadeXs.map((point) => `L ${px(point.x)},${py(point.y)}`).join(' ') +
    ` L ${px(to)},${py(survival(to))} L ${px(to)},${height - padding.bottom} Z`;

  return { px, py, curvePoints, shadePath, baseline: height - padding.bottom };
}

const left = panel(leftDomain, t1, t1 + t2, 0);

const right = panel(rightDomain, 0, t2, panelWidth + gap);

const hatchIdLeft = uid('memless-hatch-left');

const hatchIdRight = uid('memless-hatch-right');

const arrowY = height / 2;

const arrowX1 = panelWidth + 10;

const arrowX2 = panelWidth + gap - 10;
---

<svg viewBox={`0 0 ${width} ${height}`} class="c-svg" role="img" aria-label={title}>
  <title>{title}</title>

  <Hatch id={hatchIdLeft} spacing={7} />

  <Hatch id={hatchIdRight} spacing={7} />

  <line x1={0} y1={left.baseline} x2={panelWidth} y2={left.baseline} class="c-axis" aria-hidden="true" />

  <line
    x1={panelWidth + gap}
    y1={right.baseline}
    x2={width}
    y2={right.baseline}
    class="c-axis"
    aria-hidden="true"
  />

  <text x={panelWidth / 2} y={14} class="c-caps c-mid" aria-hidden="true">survival, from t₁</text>

  <text x={panelWidth + gap + panelWidth / 2} y={14} class="c-caps c-mid" aria-hidden="true">rescaled, from 0</text>

  <path d={left.shadePath} fill={`url(#${hatchIdLeft})`} aria-hidden="true" />

  <path d={right.shadePath} fill={`url(#${hatchIdRight})`} aria-hidden="true" />

  <line
    x1={left.px(t1)}
    y1={left.baseline}
    x2={left.px(t1)}
    y2={left.py(survival(t1))}
    class="c-guide-ink"
    aria-hidden="true"
  />

  <text x={left.px(t1)} y={left.baseline + 18} class="c-tick c-mid" aria-hidden="true">t₁</text>

  <polyline points={left.curvePoints} class="c-data" aria-hidden="true" />

  <polyline points={right.curvePoints} class="c-data" aria-hidden="true" />

  {
    [t1, t1 + t2].map((bound) => (
      <text x={left.px(bound)} y={left.baseline + 34} class="c-tick c-mid" aria-hidden="true">
        {Math.round(bound * 100) / 100}
      </text>
    ))
  }

  {
    [0, t2].map((bound) => (
      <text x={right.px(bound)} y={right.baseline + 18} class="c-tick c-mid" aria-hidden="true">
        {Math.round(bound * 100) / 100}
      </text>
    ))
  }

  <text x={panelWidth / 2} y={height - 6} class="c-axis-name c-mid" aria-hidden="true">
    {axisLabelX}
  </text>

  <text x={panelWidth + gap + panelWidth / 2} y={height - 6} class="c-axis-name c-mid" aria-hidden="true">
    {axisLabelX} − t₁
  </text>

  <line x1={arrowX1} y1={arrowY} x2={arrowX2} y2={arrowY} class="c-connector" aria-hidden="true" />

  <path
    d={`M ${arrowX2 - 6},${arrowY - 4} L ${arrowX2},${arrowY} L ${arrowX2 - 6},${arrowY + 4}`}
    fill="none"
    stroke="var(--color-text-muted)"
    stroke-width="1.5"
    aria-hidden="true"
  />

  <text x={(arrowX1 + arrowX2) / 2} y={arrowY - 10} class="c-tick c-mid c-halo" aria-hidden="true">
    ÷ S(t₁)
  </text>

  {
    areaLabel && (
      <>
        <text x={panelWidth / 2} y={34} class="c-value c-mid c-halo" aria-hidden="true">{areaLabel}</text>

        <text x={panelWidth + gap + panelWidth / 2} y={34} class="c-value c-mid c-halo" aria-hidden="true">{areaLabel}</text>
      </>
    )
  }
</svg>
