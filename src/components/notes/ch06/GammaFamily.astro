---
import { CHART_WIDTH, PLOT_PADDING, plot, samplePoints, scale } from '../chartkit';

// Two members of the gamma family on one axis: the exponential (alpha = 1,
// a strictly decreasing curve, ink and dashed) against a larger-alpha gamma
// (accent, solid) that rises from 0 and turns bell-shaped. The exponential
// is the alpha = 1 special case of the gamma density, so drawing both on the
// same axes is what makes that relationship visible rather than asserted.
interface Curve {
  label: string;

  tone: 'accent' | 'ink';

  fn: (x: number) => number;
}

interface Props {
  curves: Curve[];

  domain: [number, number];

  title: string;

  axisLabel?: string;

  width?: number;

  samples?: number;
}

const { curves, domain, title, axisLabel, width = CHART_WIDTH.gammaFamily, samples = 120 } = Astro.props;

const height = 224;

const p = plot(width, height, { ...PLOT_PADDING, left: 22, top: 40, bottom: axisLabel ? 48 : 34 });

const sampled = curves.map((curve) => samplePoints(curve.fn, domain, samples));

const yMax = Math.max(...sampled.flatMap((points) => points.map((point) => point.y))) * 1.15;

const x = scale(domain, [p.left, p.right]);

const y = scale([0, yMax], [p.baseline, p.top]);

const lines = curves.map((curve, i) => ({
  ...curve,
  points: sampled[i].map((point) => `${x(point.x)},${y(point.y)}`).join(' '),
}));
---

<svg viewBox={`0 0 ${width} ${height}`} class="c-svg" role="img" aria-label={title}>
  <title>{title}</title>

  <line x1={p.left} y1={p.top} x2={p.left} y2={p.baseline} class="c-axis" aria-hidden="true" />

  <line x1={p.left} y1={p.baseline} x2={p.right} y2={p.baseline} class="c-axis" aria-hidden="true" />

  <text x={p.left} y={p.top - 12} class="c-caps" aria-hidden="true">curve height</text>

  {
    lines.map((line) =>
      line.tone === 'accent' ? (
        <polyline points={line.points} class="c-data" aria-hidden="true" />
      ) : (
        <polyline
          points={line.points}
          fill="none"
          stroke="var(--color-chart-ink)"
          stroke-width="2"
          stroke-dasharray="5 4"
          stroke-linecap="round"
          aria-hidden="true"
        />
      ),
    )
  }

  {
    lines.map((line, si) => (
      <g aria-hidden="true">
        {line.tone === 'accent' ? (
          <line x1={p.right - 150} y1={12 + si * 16} x2={p.right - 138} y2={12 + si * 16} class="c-data" />
        ) : (
          <line
            x1={p.right - 150}
            y1={12 + si * 16}
            x2={p.right - 138}
            y2={12 + si * 16}
            stroke="var(--color-chart-ink)"
            stroke-width="2"
            stroke-dasharray="5 4"
          />
        )}

        <text x={p.right - 132} y={16 + si * 16} class={line.tone === 'accent' ? 'c-value' : 'c-value c-value-ink'}>
          {line.label}
        </text>
      </g>
    ))
  }

  {
    axisLabel && (
      <text x={(p.left + p.right) / 2} y={height - 8} class="c-axis-name c-mid" aria-hidden="true">
        {axisLabel}
      </text>
    )
  }
</svg>
