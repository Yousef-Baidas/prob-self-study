---
import { joinBase } from '../lib/withBase';

import { navItems } from '../lib/site';

import Menu from './icons/Menu.astro';

import Close from './icons/Close.astro';

const base = import.meta.env.BASE_URL;

const links = navItems.flatMap((item) =>
  item.children ? item.children : item.href ? [{ label: item.label, href: item.href }] : [],
);
---

<button id="mnav-open" class="mnav-btn" type="button" aria-label="Open menu" aria-expanded="false">
  <Menu />
</button>

<div id="mnav" class="mnav-overlay" hidden>
  <div class="mnav-backdrop" data-close></div>

  <nav class="mnav-panel" aria-label="Mobile" role="dialog" aria-modal="true">
    <button id="mnav-close" class="mnav-btn" type="button" aria-label="Close menu">
      <Close />
    </button>

    <div class="mnav-links">
      {links.map((l) => <a href={joinBase(base, l.href)}>{l.label}</a>)}
    </div>
  </nav>
</div>

<script>
  import { nextTrapIndex, getFocusableElements } from '../lib/focus-trap';

  const openBtn = document.getElementById('mnav-open');

  const closeBtn = document.getElementById('mnav-close');

  const overlay = document.getElementById('mnav');

  // The header's backdrop-filter makes it the containing block for this
  // position:fixed overlay, collapsing it to the header's height. Portaling the
  // overlay to <body> lets inset:0 resolve against the viewport instead.
  if (overlay) document.body.appendChild(overlay);

  const panel = overlay?.querySelector<HTMLElement>('.mnav-panel');

  const open = () => {
    if (!overlay || !openBtn || !panel) return;

    overlay.hidden = false;

    openBtn.setAttribute('aria-expanded', 'true');

    const focusables = getFocusableElements(panel);

    focusables[0]?.focus();
  };

  const close = () => {
    if (!overlay || !openBtn) return;

    overlay.hidden = true;

    openBtn.setAttribute('aria-expanded', 'false');

    openBtn.focus();
  };

  openBtn?.addEventListener('click', open);

  closeBtn?.addEventListener('click', close);

  overlay?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));

  document.addEventListener('keydown', (e) => {
    if (overlay?.hidden) return;

    if (e.key === 'Escape') close();

    if (e.key === 'Tab' && panel) {
      const focusables = getFocusableElements(panel);

      if (focusables.length === 0) return;

      const idx = focusables.indexOf(document.activeElement as HTMLElement);

      e.preventDefault();

      focusables[nextTrapIndex(focusables.length, idx < 0 ? 0 : idx, e.shiftKey)].focus();
    }
  });
</script>

<style>
  .mnav-btn {
    display: none;

    align-items: center;

    justify-content: center;

    width: 40px;

    height: 40px;

    border: 1px solid transparent;

    border-radius: var(--radius-md);

    background: transparent;

    color: var(--color-text-muted);

    cursor: pointer;
  }

  @media (max-width: 900px) {
    #mnav-open {
      display: inline-flex;
    }
  }

  .mnav-overlay {
    position: fixed;

    inset: 0;

    z-index: 100;
  }

  .mnav-backdrop {
    position: absolute;

    inset: 0;

    background: rgba(0, 0, 0, 0.4);
  }

  .mnav-panel {
    position: absolute;

    top: 0;

    right: 0;

    height: 100%;

    width: min(80vw, 300px);

    padding: var(--space-md);

    background: var(--color-surface);

    border-left: 1px solid var(--color-border);

    display: flex;

    flex-direction: column;

    gap: var(--space-md);
  }

  #mnav-close {
    display: inline-flex;

    align-self: flex-end;
  }

  .mnav-links {
    display: flex;

    flex-direction: column;

    gap: var(--space-xs);
  }

  .mnav-links a {
    padding: var(--space-sm) var(--space-md);

    border-radius: var(--radius-sm);

    color: var(--color-text);

    font-size: var(--font-size-heading);
  }

  .mnav-links a:hover {
    background: var(--color-accent-soft);
  }
</style>
