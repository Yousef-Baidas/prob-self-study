---
import Layout from '../layouts/Layout.astro';
import ExamRunner from '../islands/ExamRunner.svelte';
import ExamSetup from '../components/practice/ExamSetup.astro';
---
<Layout title="Exam — prob·web">
  <!-- Static setup slot. Hidden before paint when a run is requested. -->
  <div id="exam-setup"><ExamSetup /></div>
  <ExamRunner client:load />
  <script is:inline>
    if (new URLSearchParams(location.search).has('chapter')) {
      const el = document.getElementById('exam-setup');
      if (el) el.hidden = true;
    }
  </script>
</Layout>
