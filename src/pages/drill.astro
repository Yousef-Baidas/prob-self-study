---
import Layout from '../layouts/Layout.astro';
import DrillRunner from '../islands/DrillRunner.svelte';
import DrillSetup from '../components/practice/DrillSetup.astro';
---
<Layout title="Drill — prob·web">
  <div id="drill-setup"><DrillSetup /></div>
  <noscript><p>Drill needs JavaScript enabled to run.</p></noscript>
  <DrillRunner client:load />
  <script is:inline>
    const p = new URLSearchParams(location.search);
    if (p.has('chapter') || p.has('tk')) {
      const el = document.getElementById('drill-setup');
      if (el) el.hidden = true;
    }
  </script>
</Layout>
