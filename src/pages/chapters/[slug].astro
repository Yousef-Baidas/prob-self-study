---
import 'katex/dist/katex.min.css';

import Layout from '../../layouts/Layout.astro';

import ComingSoon from '../../components/ComingSoon.astro';

import ChapterNotes from '../../components/ChapterNotes.astro';

import { chapters } from '../../lib/site';

import { loadChapterNotes } from '../../lib/chapterNotes';

import type { InferGetStaticPropsType } from 'astro';

export function getStaticPaths() {
  return chapters.map((c) => ({ params: { slug: c.slug }, props: { chapter: c } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { chapter } = Astro.props;

const Notes = await loadChapterNotes(chapter.slug);
---

<Layout title={`${chapter.title} — prob·web`} description={`Summary notes for ${chapter.title} — GJU IE0121 (Walpole 9e): ${chapter.topics.join(', ')}.`}>
  {
    Notes ? (
      <ChapterNotes chapter={chapter}>
        <Notes />
      </ChapterNotes>
    ) : (
      <ComingSoon title={`Chapter ${chapter.number}: ${chapter.title}`} note="Chapter notes, diagrams, and embedded widgets are coming in a later update." />
    )
  }
</Layout>
